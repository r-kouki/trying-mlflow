# ── Credentials OVH S3 ──────────────────────────────────────────
# Récupérer depuis stage_mlops/.dvc/config.local
OVH_ACCESS_KEY=your-access-key-here
OVH_SECRET_KEY=your-secret-key-here
OVH_ENDPOINT=https://s3.gra.io.cloud.ovh.net/

# ── Bucket S3 ───────────────────────────────────────────────────
BUCKET_NAME=stage-mlops
DATA_PREFIX=data/

# ── MLflow (résolu via DNS Docker, pas besoin de modifier) ──────
MLFLOW_TRACKING_URI=http://mlflow-server:5000
