# ── Local venv config (no Docker, no S3 upload needed) ─────────
# Copy this file to .env.local and adjust if needed.
# data_local/ is used directly — no S3 download triggered.

# S3 credentials (read-only, used only if data_local/ is missing)
OVH_ACCESS_KEY=your-access-key-here
OVH_SECRET_KEY=your-secret-key-here
OVH_ENDPOINT=https://s3.gra.io.cloud.ovh.net/
BUCKET_NAME=stage-mlops
DATA_PREFIX=data/

# MLflow — overridden by run_local.sh to http://localhost:5000
MLFLOW_TRACKING_URI=http://localhost:5000
