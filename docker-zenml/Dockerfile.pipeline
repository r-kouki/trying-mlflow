FROM ultralytics/ultralytics:latest

WORKDIR /app

RUN pip install --no-cache-dir --timeout 300 \
    mlflow>=3.0.0 \
    boto3>=1.34.0 \
    pyyaml>=6.0 \
    "zenml[server]>=0.70.0" \
    s3fs>=2022.11.0

RUN zenml integration install mlflow s3 -y

# OVH S3 requires SigV4 + path-style addressing
RUN mkdir -p /root/.aws && printf '[default]\ns3 =\n    signature_version = s3v4\n    addressing_style = path\n' > /root/.aws/config

COPY docker-zenml/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

CMD ["/entrypoint.sh"]
