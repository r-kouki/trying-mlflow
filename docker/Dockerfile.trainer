# ── Image Entraînement YOLOv8 ───────────────────────────────────
# Basée sur ultralytics/ultralytics:latest qui inclut déjà :
#   - Python 3.11, PyTorch (CPU+GPU), torchvision, ultralytics
# On ajoute uniquement mlflow + boto3 (~50 MB au lieu de ~500 MB)
FROM ultralytics/ultralytics:latest

WORKDIR /app

# Seulement les dépendances absentes de l'image de base
RUN pip install --no-cache-dir --timeout 120 \
    mlflow>=2.16.0 \
    boto3>=1.34.0 \
    pyyaml>=6.0

# Forcer SigV4 + path-style pour OVH S3 (requis, sinon SignatureDoesNotMatch)
RUN mkdir -p /root/.aws && printf '[default]\ns3 =\n    signature_version = s3v4\n    addressing_style = path\n' > /root/.aws/config

# Le code source et les configs sont montés en volume
# pour permettre l'itération rapide sans rebuild

CMD ["python", "/app/src/train.py"]
